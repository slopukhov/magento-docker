FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

# Install Composer
COPY --from=composer:2.10 /usr/bin/composer /usr/local/bin/

# Install basic tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common \
    htop \
    vim \
    git \
    curl \
    wget \
    unzip \
    gnupg \
    default-mysql-client \
    libfreetype6-dev \
    libjpeg-turbo8-dev \
    libpng-dev \
    libmcrypt-dev \
    libsodium-dev \
    libicu-dev \
    libxslt1-dev \
    libssl-dev \
    libzip-dev \
    zlib1g-dev

# Add PHP repository and install PHP and extensions
RUN add-apt-repository ppa:ondrej/php -y && \
    apt-get update && \
    apt-get install -y php8.5-fpm php8.5-cli php8.5-dev \
    php8.5-gd php8.5-bcmath php8.5-soap php8.5-intl php8.5-mbstring \
    php8.5-zip php8.5-xsl php8.5-mysql php8.5-curl \
    php-pear php8.5-apcu php8.5-msgpack php8.5-xdebug php8.5-xhprof

RUN phpdismod xdebug xhprof

# Install uopz
RUN git clone https://github.com/krakjoe/uopz.git && \
    cd uopz && git checkout 14c8fc2 && \
    phpize8.5 && ./configure --with-php-config=php-config8.5 && make && make install

# Install php-spx
RUN git clone https://github.com/NoiseByNorthwest/php-spx.git && \
    cd php-spx && git checkout release/latest && \
    phpize8.5 && ./configure --with-php-config=php-config8.5 && make && make install

RUN mkdir -p /run/php

WORKDIR /var/www

EXPOSE 9000
CMD ["php-fpm8.5", "-F"]
