FROM ubuntu:22.04

ENV JMETER_VERSION "5.6.3"

RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y \
        openjdk-17-jre \
        xvfb \
        x11vnc \
        net-tools \
        wget \
        unzip \
        tar \
        gzip \
        openssl \
        tzdata \
        bash \
        libnss3 \
        gnupg \
        fontconfig \
        fonts-dejavu \
        php \
        php-json \
        php-xml \
        tini \
        && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN  wget -qO- -O /tmp/jmeter.tgz https://downloads.apache.org/jmeter/binaries/apache-jmeter-${JMETER_VERSION}.tgz \
    && tar -xvf /tmp/jmeter.tgz -C /tmp \
    && rm /tmp/jmeter.tgz

RUN wget -qO- -O tmp.zip http://jmeter-plugins.org/files/packages/jpgc-json-2.7.zip \
    && unzip -n tmp.zip -d /tmp/apache-jmeter-${JMETER_VERSION} \
    && rm tmp.zip

RUN wget -qO- -O tmp.zip http://jmeter-plugins.org/files/packages/jpgc-cmd-2.2.zip \
    && unzip -n tmp.zip -d /tmp/apache-jmeter-${JMETER_VERSION} \
    && rm tmp.zip

RUN wget -qO- -O tmp.zip http://jmeter-plugins.org/files/packages/jpgc-synthesis-2.2.zip \
    && unzip -n tmp.zip -d /tmp/apache-jmeter-${JMETER_VERSION} \
    && rm tmp.zip

RUN wget -qO- -O tmp.zip http://jmeter-plugins.org/files/packages/jpgc-filterresults-2.2.zip \
    && unzip -n tmp.zip -d /tmp/apache-jmeter-${JMETER_VERSION} \
    && rm tmp.zip

RUN chmod -R 755 /tmp/apache-jmeter-${JMETER_VERSION}

ENV PATH="$PATH:/tmp/apache-jmeter-${JMETER_VERSION}/bin"

RUN mkdir -p /root/.vnc && \
    x11vnc -storepasswd password /etc/x11vnc.pass

COPY scripts/start.sh /start.sh
RUN chmod +x /start.sh

EXPOSE 5900

ENTRYPOINT ["/usr/bin/tini", "--"]

CMD ["/start.sh"]
