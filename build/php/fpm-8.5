FROM ubuntu:24.04 AS extension-builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common gnupg git build-essential zlib1g-dev \
    && add-apt-repository ppa:ondrej/php -y \
    && apt-get update \
    && apt-get install -y --no-install-recommends php8.5-dev \
    && rm -rf /var/lib/apt/lists/*

RUN git clone https://github.com/krakjoe/uopz.git && \
    cd uopz && git checkout 14c8fc2 && \
    phpize8.5 && ./configure --with-php-config=php-config8.5 && make && make install

RUN git clone https://github.com/NoiseByNorthwest/php-spx.git && \
    cd php-spx && git checkout release/latest && \
    phpize8.5 && ./configure --with-php-config=php-config8.5 && make && make install

RUN mkdir -p /artifacts && \
    cp "$(php-config8.5 --extension-dir)/uopz.so" /artifacts/ && \
    cp "$(php-config8.5 --extension-dir)/spx.so" /artifacts/ && \
    cp -r /usr/share/misc/php-spx /artifacts/php-spx-assets

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

# Install Composer
COPY --from=composer:2.10 /usr/bin/composer /usr/local/bin/

# Install basic tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common \
    htop \
    vim \
    git \
    curl \
    wget \
    unzip \
    gnupg \
    default-mysql-client \
    && rm -rf /var/lib/apt/lists/* /usr/share/doc/* /usr/share/man/*

# Add PHP repository and install PHP and extensions
RUN add-apt-repository ppa:ondrej/php -y && \
    apt-get update && \
    apt-get install -y --no-install-recommends php8.5-fpm php8.5-cli \
    php8.5-gd php8.5-bcmath php8.5-soap php8.5-intl php8.5-mbstring \
    php8.5-zip php8.5-xsl php8.5-mysql php8.5-curl \
    php-pear php8.5-apcu php8.5-msgpack php8.5-xdebug php8.5-xhprof && \
    rm -rf /var/lib/apt/lists/* /usr/share/doc/* /usr/share/man/*

RUN phpdismod xdebug xhprof

COPY --from=extension-builder /artifacts/uopz.so /artifacts/spx.so /tmp/extension-builder-artifacts/
RUN mv /tmp/extension-builder-artifacts/uopz.so /tmp/extension-builder-artifacts/spx.so "$(php8.5 -r 'echo ini_get("extension_dir");')/" && \
    rm -rf /tmp/extension-builder-artifacts
COPY --from=extension-builder /artifacts/php-spx-assets /usr/share/misc/php-spx

RUN mkdir -p /run/php

WORKDIR /var/www

EXPOSE 9000
CMD ["php-fpm8.5", "-F"]
